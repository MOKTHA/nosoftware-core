# HeyNXT Core Service Workers Environment Configuration
# Copy this file to .env and customize for your environment

# -----------------------------------------------------------------------------
# Database Connection (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://heynxt:heynxt@localhost:5432/heynxt

# Redis connection URL (BullMQ queue backend)
REDIS_URL=redis://localhost:6379

# Node environment (development, production, test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Worker Concurrency Settings
# Adjust based on expected load and available resources
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY_WORKFLOW=5        # Workflow executor parallelism
WORKER_CONCURRENCY_EVENT=10           # Event ingestion parallelism
WORKER_CONCURRENCY_RULES=5            # Rule evaluation parallelism
WORKER_CONCURRENCY_NOTIFICATION=3     # Notification dispatch parallelism

# -----------------------------------------------------------------------------
# Queue Names (can be customized per environment)
# -----------------------------------------------------------------------------
QUEUE_NAME_WORKFLOW=workflow_queue
QUEUE_NAME_EVENT=event_queue
QUEUE_NAME_RULES=rules_queue
QUEUE_NAME_NOTIFICATION=notification_queue

# -----------------------------------------------------------------------------
# Email Notifications (SMTP Configuration)
# Optional - only required if using email notifications
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# Slack Webhook URL for real-time alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
