# =============================================================================
# @heynxt/web environment variables
# =============================================================================
# Copy this file to `.env.local` (gitignored) and fill in the values.
# Next.js auto-loads `.env.local` when running `next dev` / `next build`.
#
# The `DATABASE_URL` below matches the Postgres 15 container spun up by
# `pnpm dev:db` (see docker-compose.yml). It is the same value declared
# in the repository root `.env.example`.

NODE_ENV=development

# Local dev — Postgres 15 container. Match the credentials in
# docker-compose.yml.
DATABASE_URL=postgresql://heynxt:heynxt@localhost:5432/heynxt

# ─────────────────────────────────────────────────────────────────────
# Auth.js (next-auth@5) — see docs/adr/0008-auth-library-and-provider.md
# ─────────────────────────────────────────────────────────────────────
#
# AUTH_SECRET is required — Auth.js uses it to sign session cookies and
# CSRF tokens. Generate one with:
#
#   openssl rand -base64 32
#
# Copy the output into AUTH_SECRET in `.env.local`. Keep out of source.
#
# GITHUB OAuth App (ADR-0008):
#   1. Go to https://github.com/settings/developers → OAuth Apps → New.
#   2. Set Authorization callback URL to:
#        http://localhost:3000/api/auth/callback/github
#   3. Copy Client ID and Client Secret into the two fields below.
#
# If the env vars aren't set, the GitHub sign-in button will fail to
# render, but the rest of the app will still work as it did before.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Trust the request host when computing redirect URLs. Required when
# running behind a proxy (ngrok, railway, etc.). Optional for direct
# localhost dev.
AUTH_TRUST_HOST=true
