# =============================================================================
# heynxt-core environment configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local dev (use `pnpm dev:db` to start a Postgres 15 container — see
# docs/dev-setup.md and docker-compose.yml). Connection string below matches
# the credentials declared in docker-compose.yml.
DATABASE_URL=postgresql://heynxt:heynxt@localhost:5432/heynxt

# Production (Neon serverless). Fill in per workspace; never commit .env.
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# -----------------------------------------------------------------------------
# Agent Runtime
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Industrial Blueprint Sources
# -----------------------------------------------------------------------------
FactoryNXT_PY_V2_PATH=
FactoryNXT_PY_v2_Extrusion_PATH=
