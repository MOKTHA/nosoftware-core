# HeyNXT Core — Environment Variables Template
# Copy this file to .env.local and customize for your environment

# =============================================================================
# Database (Postgres via Neon serverless or local)
# =============================================================================
DATABASE_URL=postgresql://heynxt:heynxt@localhost:5432/heynxt

# For Neon serverless production, use format like:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/heynxt?sslmode=require

# =============================================================================
# Redis (for service workers queue)
# =============================================================================
REDIS_URL=redis://localhost:6379

# For cloud Redis (Upstash, AWS ElastiCache, etc.):
# REDIS_URL=https://xxx.upstash.io

# =============================================================================
# Node Environment
# =============================================================================
NODE_ENV=development
# Options: development, production, test

# =============================================================================
# Authentication
# =============================================================================
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
AUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=

# =============================================================================
# Service Workers Configuration
# =============================================================================
WORKER_CONCURRENCY_WORKFLOW=5
WORKER_CONCURRENCY_EVENT=10
WORKER_CONCURRENCY_RULES=5
WORKER_CONCURRENCY_NOTIFICATION=3

# Queue names (can be customized per environment)
QUEUE_NAME_WORKFLOW=workflow_queue
QUEUE_NAME_EVENT=event_queue
QUEUE_NAME_RULES=rules_queue
QUEUE_NAME_NOTIFICATION=notification_queue

# =============================================================================
# Email Notifications (SMTP)
# =============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@heynxt.local

# For local SMTP testing:
# SMTP_HOST=localhost
# SMTP_PORT=2525
# SMTP_FROM=test@example.com

# =============================================================================
# Slack Notifications
# =============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# Sandbox & Pipeline (Phase 5 — live mode)
# =============================================================================
# Required for live pipeline execution (Neon DB provisioning + LLM code gen).
# Without these, pipeline stages run in stub mode.
NEON_API_KEY=
NEON_ORG_ID=
OPENROUTER_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# =============================================================================
# Rate Limiting (optional)
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
