{
  "name": "@heynxt/persistence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'TODO: add linter'",
    "clean": "rm -rf dist drizzle/__drizzle.lock",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:generate": "pnpm build && drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:reset": "drizzle-kit drop --config=drizzle.config.ts && drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@heynxt/core-types": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
